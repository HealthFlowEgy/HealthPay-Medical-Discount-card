{
  "name": "@healthpay/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi": "pnpm --filter @healthpay/shared build && tsx scripts/generate-openapi.ts",
    "demo": "pnpm --filter @healthpay/db build && tsx scripts/demo.ts"
  },
  "dependencies": {
    "@healthpay/db": "workspace:*",
    "@healthpay/shared": "workspace:*",
    "@vercel/blob": "^0.27.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.33.0",
    "jose": "^5.6.3",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "zod-to-json-schema": "^3.23.2"
  }
}
