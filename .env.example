# ─────────────────────────────────────────────────────────────────────────────
# HealthPay Quote Engine — environment template
# Copy to .env (local) and configure real secrets in your deploy platform.
# NEVER commit a real .env. Secrets are read from the environment only.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string (Neon in production).
DATABASE_URL="postgresql://user:password@localhost:5432/healthpay?sslmode=disable"

# AES-256-GCM key for PII-at-rest encryption (national_id, mobile).
# Must be 32 bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"

# Default quote validity window in hours (state machine default = 48).
QUOTE_VALIDITY_HOURS="48"

# ── SMS ──────────────────────────────────────────────────────────────────────
# Provider selector: "console" (dev, logs link) | "twilio" | "smsmisr"
SMS_PROVIDER="console"
SMS_SENDER_ID="HealthPay"
# Vendor stubs (only required when the matching provider is selected):
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
SMSMISR_USERNAME=""
SMSMISR_PASSWORD=""

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL used to build hosted quote-page links sent over SMS.
APP_BASE_URL="http://localhost:3000"

# Ops session secret (cookie signing / JWT).
OPS_SESSION_SECRET="REPLACE_WITH_RANDOM_SECRET"

# Comma-separated partner origins allowed to use the browser embed helper (CORS).
PARTNER_ALLOWED_ORIGINS="http://localhost:5173"

# Per-partner rate limit (requests per minute).
RATE_LIMIT_PER_MINUTE="60"
