{
  "name": "@healthpay/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle schema, migrations, encryption helpers and seed data.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "source": "./src/schema.ts",
      "types": "./src/schema.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "pnpm --filter @healthpay/shared build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "pnpm --filter @healthpay/shared build && drizzle-kit generate",
    "migrate": "pnpm --filter @healthpay/shared build && drizzle-kit migrate",
    "seed": "pnpm --filter @healthpay/shared build && tsx src/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@healthpay/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.33.0",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.0",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
